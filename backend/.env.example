# Copy to .env and fill in. Never commit .env.

# --- required ---
# Local:  mongodb://127.0.0.1:27017/civiclens
# Atlas:  mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/civiclens
MONGODB_URI=mongodb://127.0.0.1:27017/civiclens

PORT=5000

# Signs login/signup JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Admin panel credentials. Admin accounts cannot be created from any public
# form — set these, then run `npm run seed:admin` to provision the account.
ADMIN_NAME=CivicLens Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- optional ---
# Without these the server still runs; AI classification and X scraping
# are skipped and complaints fall back to schema defaults.

# AI classification via OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# X/Twitter scraping (https://developer.twitter.com)
X_BEARER_TOKEN=
